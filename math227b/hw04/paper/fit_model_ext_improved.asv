function results = fit_breast_cancer_models(t_data_full, N_data_full)
    %% =============================================================
    %% 1. Data Subsetting (Step 1: First 10 Days)
    %% =============================================================
    % We subset the data here so the optimizer focuses on the growth phase
    fit_mask = t_data_full <= 10;
    t_data = t_data_full(fit_mask);
    N_data = N_data_full(fit_mask);
    
    %% =============================================================
    %% 2. Settings
    %% =============================================================
    tau = 1.2;
    tspan_fit = [min(t_data) max(t_data)];
    N0 = N_data(1);
    
    %% =============================================================
    %% 3. Initial Guess (Step 2: Adding v0 and v1)
    %% =============================================================
    % theta = [f_csc, f_pc, v0, v1]
    % Initial guesses: fractions ~0.05, proliferation rates ~0.2-0.5
    theta0 = [0.05, 0.1, 0.25, 0.50]; 
    
    lb = [0.00, 0.0, 0.01, 0.01]; % Lower bounds
    ub = [1.00, 1.0, 1.50, 2.50]; % Upper bounds
    
    options = optimoptions('lsqnonlin', ...
        'Display','iter', ...
        'MaxIterations',400, ...
        'FunctionTolerance',1e-8);
    
    %% =============================================================
    %% 4. Define Parameter Structs & Model List
    %% =============================================================
    % Base parameters (beta and gamma values stay fixed during this optimization)
    p_base = struct('p0',0.5,'q0',0.2,'p1',0.5,'q1',0.1,...
                    'd0',0.01,'d1',0.05,'d2',0.1,...
                    'gamma01',1e-14,'gamma02',1e-16,...
                    'gamma11',1e-13,'gamma12',1e-15,...
                    'beta0',8e-12,'beta1',4e-13);
    
    models = { ...
        struct('name','Combined','func',@dde_combined,'params',p_base,'color','r'), ...
        struct('name','TypeII',  'func',@dde_typeII,  'params',p_base,'color','g'), ...
        struct('name','TypeI',   'func',@dde_typeI,   'params',p_base,'color','b'), ...
        struct('name','Basic',   'func',@dde_basic,   'params',p_base,'color','k')};
    
    %% =============================================================
    %% 5. Fit Each Model
    %% =============================================================
    results = struct;
    
    for i = 1:length(models)
        m = models{i};
        fprintf('\n--- Fitting Model: %s ---\n', m.name);
        
        objfun = @(theta) model_residual(theta, m.func, m.params, t_data, N_data, tspan_fit, tau, N0);
        theta_fit = lsqnonlin(objfun, theta0, lb, ub, options);
    
        results(i).theta  = theta_fit;
        results(i).name   = m.name;
        results(i).func   = m.func;
        results(i).params = m.params;
        results(i).color  = m.color;
    end
    
    %% =============================================================
    %% 6. Plot Results (Full 20-day range)
    %% =============================================================
    figure; hold on; grid on;
    % Plot full original data in grey and the fitted subset in black
    scatter(t_data, N_data, 50, 'k', 'filled', 'DisplayName', 'Data');
    
    tplot = linspace(0, max(t_data_full), 300);
    tspan_sim = [0 max(t_data_full)];
    
    for i = 1:length(results)
        theta = results(i).theta;
        N_model = simulate_model(theta, results(i).func, results(i).params, tplot, tspan_sim, tau, N0);
        plot(tplot, N_model, 'Color', results(i).color, 'LineWidth', 2, 'DisplayName', results(i).name);
    end
    
    legend('Location', 'northwest');
    xlabel('Time (days)'); ylabel('Total Cells');
    title('Model Fit with Optimized Proliferation (v0, v1)');
    axis([[0]])
end

%% =============================================================
%% Supporting Functions
%% =============================================================

function r = model_residual(theta, model_func, params, t_data, N_data, tspan, tau, N0)
    N_model = simulate_model(theta, model_func, params, t_data, tspan, tau, N0);
    % Log-transform residuals to equalize weighting across scales
    r = log(N_model(:)) - log(N_data(:));
end

function N_model = simulate_model(theta, model_func, params, t_eval, tspan, tau, N0)
    % Update the proliferation rates in the parameter struct
    params.v0 = theta(3);
    params.v1 = theta(4);
    
    f_csc = theta(1);
    f_pc  = theta(2);
    f_tdc = max(0, 1 - f_csc - f_pc);
    
    history = N0 * [f_csc; f_pc; f_tdc];
    
    % Solver options to handle DDE stability
    opts = ddeset('RelTol', 1e-5, 'AbsTol', 1e-8);
    sol = dde23(@(t,y,Z) model_func(t,y,Z,params), tau, history, tspan, opts);
    
    y = deval(sol, t_eval);
    N_model = sum(y, 1);
end

%% =============================================================
%% --- DDE Model Definitions ---
%% =============================================================

function dydt = dde_combined(t,y,Z,p)
    x0 = y(1); x1 = y(2); x2 = y(3);
    x2_delayed = Z(3,1);
    p0_eff = p.p0 / (1 + p.gamma01 * x2_delayed^2);
    q0_eff = p.q0 / (1 + p.gamma02 * x2_delayed^2);
    p1_eff = p.p1 / (1 + p.gamma11 * x2_delayed^2);
    q1_eff = p.q1 / (1 + p.gamma12 * x2_delayed^2);
    v0_eff = p.v0 / (1 + p.beta0 * x2_delayed^2);
    v1_eff = p.v1 / (1 + p.beta1 * x2_delayed^2);
    dydt = [(p0_eff - q0_eff)*v0_eff*x0 - p.d0*x0;
            (1 - p0_eff + q0_eff)*v0_eff*x0 + (p1_eff - q1_eff)*v1_eff*x1 - p.d1*x1;
            (1 - p1_eff + q1_eff)*v1_eff*x1 - p.d2*x2];
end

function dydt = dde_typeII(t,y,Z,p)
    x0 = y(1); x1 = y(2); x2 = y(3);
    x2_delayed = Z(3,1);
    p0_eff = p.p0 / (1 + p.gamma01 * x2_delayed^2);
    q0_eff = p.q0 / (1 + p.gamma02 * x2_delayed^2);
    p1_eff = p.p1 / (1 + p.gamma11 * x2_delayed^2);
    q1_eff = p.q1 / (1 + p.gamma12 * x2_delayed^2);
    dydt = [(p0_eff - q0_eff)*p.v0*x0 - p.d0*x0;
            (1 - p0_eff + q0_eff)*p.v0*x0 + (p1_eff - q1_eff)*p.v1*x1 - p.d1*x1;
            (1 - p1_eff + q1_eff)*p.v1*x1 - p.d2*x2];
end

function dydt = dde_typeI(t,y,Z,p)
    x0 = y(1); x1 = y(2); x2 = y(3);
    x2_delayed = Z(3,1);
    v0_eff = p.v0 / (1 + p.beta0 * x2_delayed^2);
    v1_eff = p.v1 / (1 + p.beta1 * x2_delayed^2);
    dydt = [(p.p0 - p.q0)*v0_eff*x0 - p.d0*x0;
            (1 - p.p0 + p.q0)*v0_eff*x0 + (p.p1 - p.q1)*v1_eff*x1 - p.d1*x1;
            (1 - p.p1 + p.q1)*v1_eff*x1 - p.d2*x2];
end

function dydt = dde_basic(~,y,~,p)
    x0 = y(1); x1 = y(2); x2 = y(3);
    dydt = [(p.p0 - p.q0)*p.v0*x0 - p.d0*x0;
            (1 - p.p0 + p.q0)*p.v0*x0 + (p.p1 - p.q1)*p.v1*x1 - p.d1*x1;
            (1 - p.p1 + p.q1)*p.v1*x1 - p.d2*x2];
end

% ====================

% Load data from files
M10 = readmatrix('data/tumor_growth_10nM.csv');
time_days = M10(:, 1);
data_10nM = M10(:, 2:end);

M20 = readmatrix('data/tumor_growth_20nM.csv');
data_20nM = M20(:, 2:end);

N_data = rep6(:, 2);
results = fit_breast_cancer_models(time_days, data_20nM(:, 1));

% ====================